{
  "name": "gsd-beads",
  "version": "1.0.0-alpha.0",
  "description": "BeadsAdapter implementation of the get-shit-done StorageAdapter contract; requires bd v1.0.4+.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CLAUDE.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bd": {
    "minVersion": "1.0.4",
    "note": "Runtime-enforced by BeadsAdapter.init() via `bd --version` probe (Plan 06-05). v1.0.3 rejected: missing `--metadata` primitive (D-MAPPING Outcome A) + incompatible `bd init --from-jsonl` invocation shape. See D-2026-05-12-OQ06-MAPPING + D-2026-05-12-OQ06-TXN ADRs in the fork's .planning/DECISIONS.md."
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run tests/smoke",
    "test:conformance": "vitest run tests/conformance.test.ts"
  },
  "peerDependencies": {
    "get-shit-done-cc": "*"
  },
  "peerDependenciesMeta": {
    "get-shit-done-cc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "get-shit-done-cc": "file:../get-shit-done",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
